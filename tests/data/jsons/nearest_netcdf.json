{
  "Execution": {
    "@name": "json-e2e nearest netcdf",
    "OutMaps": {
      "@cloneMap": "tests/data/dem.map",
      "@fmap": 1,
      "@ext": 1,
      "@unitTime": 24,
      "@namePrefix": "pg",
      "@format": "netcdf",
      "Interpolation": {
        "@latMap": "tests/data/lat.map",
        "@lonMap": "tests/data/lon.map",
        "@mode": "nearest",
        "@intertableDir": "tests/data"
      }
    },
    "Parameter": {
      "@shortName": "2t",
      "@applyConversion": "k2c"
    }
  }
}
